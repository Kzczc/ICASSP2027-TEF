# Copy this file to .env, fill in the values, and export them before running the scripts:
#   cp .env.example .env && set -a && source .env && set +a
# .env is listed in .gitignore. Never commit API keys.

# ---- Data -------------------------------------------------------------------
# Directory containing mind_zh.jsonl and mind_en.jsonl. Leave empty to use ./data.
MIND_DATA_DIR=

# ---- Open-source models served with vLLM ------------------------------------
# A Hugging Face model ID or an absolute local path, e.g. /data/models/Qwen2.5-7B-Instruct
QWEN25_7B_PATH=Qwen/Qwen2.5-7B-Instruct
LLAMA3_8B_PATH=meta-llama/Meta-Llama-3-8B-Instruct
QWEN3_14B_PATH=Qwen/Qwen3-14B
# Tensor-parallel sizes (number of GPUs per model)
QWEN25_7B_TP=1
LLAMA3_8B_TP=1
QWEN3_14B_TP=2

# ---- Proprietary models ------------------------------------------------------
# DeepSeek-V3.2 through the official API (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# GPT-4o-mini through the OpenAI API; set OPENAI_BASE_URL only for a compatible proxy
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ---- OpenAI-compatible vLLM server (scripts/efficiency.py) -------------------
VLLM_BASE_URL=http://localhost:8000/v1
# vLLM accepts any non-empty key unless the server was started with --api-key
VLLM_API_KEY=EMPTY
QWEN25_7B_SERVED_NAME=Qwen2.5-7B-Instruct
LLAMA3_8B_SERVED_NAME=Meta-Llama-3-8B-Instruct
